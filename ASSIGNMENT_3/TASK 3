#include <stdio.h>

#define SEGMENTS 4

// Segment table: base address and limit
int base[SEGMENTS]  = {1000, 5000, 9000, 12000};
int limit[SEGMENTS] = {400, 1000, 800, 600};

int main()
{
    // (segment number, offset)
    int addresses[8][2] = {
        {0, 0},
        {0, 399},
        {0, 400},
        {1, 100},
        {1, 999},
        {1, 1000},
        {2, 750},
        {3, 601}
    };

    printf("SEGMENT ADDRESS TRANSLATION\n\n");

    for (int i = 0; i < 8; i++)
    {
        int segment = addresses[i][0];
        int offset = addresses[i][1];

        printf("Segment %d, Offset %d : ", segment, offset);

        if (segment < 0 || segment >= SEGMENTS)
        {
            printf("Invalid segment\n");
        }
        else if (offset < 0 || offset >= limit[segment])
        {
            printf("Segmentation fault (invalid offset)\n");
        }
        else
        {
            int physical = base[segment] + offset;
            printf("Physical Address = %d\n", physical);
        }
    }

    return 0;
}
